<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- BACK -->

        <TextView
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="←  Back to My Registrations"
            android:textColor="#3155D4"
            android:textSize="15sp"
            android:textStyle="bold"
            android:padding="8dp"/>

        <!-- LOGO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:gravity="center"
                android:text="✦"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"
                android:background="#3155D4"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="EVENTNEST"
                android:textColor="#3155D4"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"/>

        </LinearLayout>

        <!-- TITLE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="DIGITAL EVENT PASS"
            android:textColor="#172554"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="Your registration is confirmed"
            android:textColor="#697082"
            android:textSize="14sp"/>

        <!-- PASS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎫  EVENT PASS"
                android:textColor="#3155D4"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"/>

            <TextView
                android:id="@+id/passEventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Tech Fest 2026"
                android:textColor="#172554"
                android:textSize="27sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="DATE"
                android:textColor="#3155D4"
                android:textSize="10sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/passDateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="15 October 2026"
                android:textColor="#172554"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="VENUE"
                android:textColor="#3155D4"
                android:textSize="10sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/passVenueText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="University Auditorium"
                android:textColor="#172554"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <!-- QR STYLE -->

            <TextView
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:layout_marginTop="25dp"
                android:gravity="center"
                android:text="▦"
                android:textColor="#172554"
                android:textSize="120sp"
                android:background="#F3F5FA"/>

            <TextView
                android:id="@+id/passIdText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center"
                android:text="PASS ID: EN-2026-001"
                android:textColor="#697082"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <!-- STATUS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="18dp"
                android:text="✓  REGISTERED"
                android:textColor="#16A34A"
                android:textSize="12sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- NOTE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Show this digital pass when attending the event."
            android:textColor="#7B8191"
            android:textSize="12sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="✦  EventNest"
            android:textColor="#3155D4"
            android:textSize="12sp"
            android:textStyle="bold"/>

    </LinearLayout>

</ScrollView>